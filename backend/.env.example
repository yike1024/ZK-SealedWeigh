# 零知识密封加权评审系统（ZK-SealedWeigh） 环境变量样例
# 用法：复制本文件为 backend/.env，按需修改。
# 注意：backend/.env 含有密钥，已被 .gitignore 排除，切勿提交到仓库。

# ---- 数据库（SQL Server）----
DB_SERVER=localhost
DB_NAME=ZKVotingSystem
DB_USER=sa
DB_PASSWORD=change-me
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# ---- 服务 ----
HOST=0.0.0.0
PORT=5000
DEBUG=False

# ---- CORS ----
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- 区块链（本地 Hardhat 链）----
# 用 127.0.0.1 而非 localhost：Windows 解析 localhost 会先走 IPv6(::1)，
# 而 Hardhat 只监听 IPv4，每次连接会多等约 2s。
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# 填入 scripts/deploy.ts 打印的合约地址（start-all.ps1 会自动写入）
CONTRACT_ADDRESS=
# relayer 私钥；本地开发用 Hardhat 默认账户#0；严禁用于真实资产
DEPLOYER_PRIVATE_KEY=
CHAIN_ID=31337
